{
  "manifest_version": 3,
  "name": "ECHO Online",
  "version": "1.0.0",
  "description": "ECHO Browser Assistant",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "commands"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*/*"
  ],

  "action": {
    "default_title": "Open ECHO Online"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["*.js", "*.css", "speech.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "wake-echo": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Wake ECHO"
    }
  }
}
